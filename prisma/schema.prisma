// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  DEPUTY_OWNER
  ADMIN
  MANAGER
  MASTER
}

enum AppointmentStatus {
  BOOKED
  CANCELLED
  ARRIVED
  DONE
}

enum LogLevel {
  ERROR
  WARN
  INFO
  DEBUG
  VERBOSE
}

enum LogType {
  HTTP_REQUEST
  HTTP_RESPONSE
  ERROR
  AUTH
  DATABASE
  BUSINESS_LOGIC
  SYSTEM
}

enum NotificationType {
  NEW_APPOINTMENT // Новая запись для мастера
  APPOINTMENT_CANCELLED // Отмена записи для менеджера
  BLACKLIST_REQUEST // Запрос на добавление в черный список для владельца
}

enum WarehouseType {
  CENTRAL
  BRANCH
}

enum ProductUnit {
  KG   // Кг
  PCS  // шт
  ML   // мл
}

enum StockMovementType {
  RECEIPT   // Приход
  WRITE_OFF // Списание
}

model Studio {
  id        String   @id @default(uuid())
  name      String
  address   String?
  timezone  String   @default("Asia/Almaty")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  clients               Client[]
  workSchedules         WorkScheduleDay[]
  busySlots             BusySlot[]
  services              Service[]
  appointments          Appointment[]
  staffServices         StaffService[]
  staffServiceOverrides StaffServiceOverride[]
  noShowIncomes         NoShowIncome[]
  Notification          Notification[]
  blacklistRequests     BlacklistRequest[]
  warehouse             Warehouse?  // Склад филиала (один на студию)

  @@map("studios")
}

model User {
  id              String   @id @default(uuid())
  email           String?  @unique
  phone           String?  @unique
  passwordHash    String
  password        String? // Plain password (visible to OWNER and DEPUTY_OWNER)
  role            UserRole
  studioId        String?
  isActive        Boolean  @default(true)
  themePreference String? // 'light' | 'dark' | 'system'
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  studio                    Studio?                @relation(fields: [studioId], references: [id], onDelete: Cascade)
  staffProfile              StaffProfile?
  workSchedules             WorkScheduleDay[]
  busySlots                 BusySlot[]
  appointments              Appointment[]
  staffServices             StaffService[]
  serviceOverrides          StaffServiceOverride[]
  arrivedAppointments       Appointment[]          @relation("ArrivedByUser")
  noShowIncomes             NoShowIncome[]
  notifications             Notification[]
  blacklistRequests         BlacklistRequest[] // Запросы, созданные пользователем
  approvedBlacklistRequests BlacklistRequest[]     @relation("ApprovedByUser") // Запросы, одобренные пользователем
  transfers                 Transfer[]
  stockMovements            StockMovement[]

  @@index([studioId])
  @@index([email])
  @@index([phone])
  @@map("users")
}

model StaffProfile {
  userId           String   @id
  firstName        String
  lastName         String?
  title            String?
  category         String?
  providesServices Boolean  @default(true)
  avatar           String?
  bio              String?
  portfolioPhotos  String[]
  rank             String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff_profiles")
}

model Client {
  id             String   @id @default(uuid())
  studioId       String
  firstName      String
  lastName       String?
  phone          String
  notes          String?
  birthDate      DateTime? @db.Date // День рождения клиента
  bonuses        Int      @default(0) // Бонусные баллы
  discount       Int      @default(0) // Скидка в процентах (0-100)
  balance        Int      @default(0) // Баланс в тенге
  isBlacklisted  Boolean  @default(false) // Флаг черного списка
  blacklistReason String? // Причина добавления в черный список
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  studio            Studio             @relation(fields: [studioId], references: [id], onDelete: Cascade)
  appointments      Appointment[]
  noShowIncomes     NoShowIncome[]
  blacklistRequests BlacklistRequest[]

  @@unique([studioId, phone])
  @@index([studioId])
  @@index([studioId, isBlacklisted])
  @@map("clients")
}

model WorkScheduleDay {
  id          String   @id @default(uuid())
  studioId    String
  staffUserId String
  date        DateTime @db.Date
  startTime   String // HH:MM format
  endTime     String // HH:MM format
  breakStart  String? // HH:MM format
  breakEnd    String? // HH:MM format
  isDayOff    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  staff  User   @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@unique([studioId, staffUserId, date])
  @@index([studioId, staffUserId, date])
  @@map("work_schedule_days")
}

model BusySlot {
  id                        String   @id @default(uuid())
  studioId                  String
  staffUserId               String
  startAt                   DateTime
  endAt                     DateTime
  comment                   String?
  forfeitedPrepaymentAmount Int?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  staff  User   @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([studioId, staffUserId, startAt])
  @@map("busy_slots")
}

model Service {
  id                 String   @id @default(uuid())
  studioId           String
  name               String
  defaultDurationMin Int
  defaultPrice       Int?
  requiredStaffCount Int      @default(1)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  studio             Studio                 @relation(fields: [studioId], references: [id], onDelete: Cascade)
  staffServices      StaffService[]
  staffOverrides     StaffServiceOverride[]
  appointments       Appointment[]
  noShowIncomes      NoShowIncome[]
  appointmentUpsells AppointmentUpsell[]

  @@index([studioId])
  @@map("services")
}

model StaffService {
  id          String   @id @default(uuid())
  studioId    String
  staffUserId String
  serviceId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studio  Studio  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  staff   User    @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([studioId, staffUserId, serviceId])
  @@index([studioId, staffUserId])
  @@index([serviceId])
  @@map("staff_services")
}

model StaffServiceOverride {
  id          String   @id @default(uuid())
  studioId    String
  staffUserId String
  serviceId   String
  durationMin Int?
  price       Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studio  Studio  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  staff   User    @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([studioId, staffUserId, serviceId])
  @@index([studioId, staffUserId])
  @@map("staff_service_overrides")
}

model Appointment {
  id                        String            @id @default(uuid())
  studioId                  String
  staffUserId               String
  clientId                  String
  serviceId                 String
  startAt                   DateTime
  endAt                     DateTime
  status                    AppointmentStatus @default(BOOKED)
  prepaymentAmount          Int?
  forfeitedPrepaymentAmount Int? // Предоплата, сгоревшая при поздней отмене
  arrivedAt                 DateTime?
  arrivedByUserId           String?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  studio        Studio              @relation(fields: [studioId], references: [id], onDelete: Cascade)
  staff         User                @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  client        Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service       Service             @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  arrivedByUser User?               @relation("ArrivedByUser", fields: [arrivedByUserId], references: [id])
  upsells       AppointmentUpsell[]

  @@index([studioId, staffUserId, startAt])
  @@index([studioId, startAt])
  @@index([clientId])
  @@map("appointments")
}

model AppointmentUpsell {
  id            String   @id @default(uuid())
  appointmentId String
  serviceId     String
  quantity      Int      @default(1)
  price         Int
  totalAmount   Int
  comment       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([appointmentId])
  @@index([serviceId])
  @@index([appointmentId, createdAt])
  @@map("appointment_upsells")
}

model Log {
  id         String   @id @default(uuid())
  level      LogLevel
  type       LogType
  message    String
  context    String? // JSON string with additional context
  userId     String? // User who triggered the action
  studioId   String? // Studio context
  ip         String? // IP address
  userAgent  String? // User agent
  method     String? // HTTP method
  url        String? // Request URL
  statusCode Int? // HTTP status code
  error      String? // Error stack trace or details
  duration   Int? // Request duration in ms
  createdAt  DateTime @default(now())

  @@index([level])
  @@index([type])
  @@index([createdAt])
  @@index([userId])
  @@index([studioId])
  @@map("logs")
}

model NoShowIncome {
  id              String   @id @default(uuid())
  studioId        String
  staffUserId     String
  clientId        String
  serviceId       String
  amount          Int // Сумма предоплаты, добавленная в доход
  originalStartAt DateTime // Оригинальное время начала записи
  originalEndAt   DateTime // Оригинальное время окончания записи
  createdAt       DateTime @default(now())

  studio  Studio  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  staff   User    @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([studioId, createdAt])
  @@index([studioId, originalStartAt])
  @@map("no_show_incomes")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String // Пользователь, которому адресовано уведомление
  studioId  String
  type      NotificationType
  title     String
  message   String
  data      String? // JSON с дополнительными данными (appointmentId, clientId и т.д.)
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([studioId, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model BlacklistRequest {
  id                String    @id @default(uuid())
  studioId          String
  clientId          String
  requestedByUserId String // Кто создал запрос (MANAGER или ADMIN)
  approvedByUserId  String? // Кто одобрил (OWNER или DEPUTY_OWNER)
  status            String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reason            String? // Причина добавления в ЧС
  rejectedReason    String? // Причина отклонения
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  approvedAt        DateTime?
  rejectedAt        DateTime?

  studio      Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  client      Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requestedBy User   @relation(fields: [requestedByUserId], references: [id], onDelete: Cascade)
  approvedBy  User?  @relation("ApprovedByUser", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([studioId])
  @@index([clientId])
  @@index([status])
  @@index([requestedByUserId])
  @@index([studioId, status])
  @@map("blacklist_requests")
}

// --- Склад ---
model Warehouse {
  id        String        @id @default(uuid())
  type      WarehouseType // CENTRAL | BRANCH
  studioId  String?       @unique // null для центрального склада
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  studio         Studio?         @relation(fields: [studioId], references: [id], onDelete: Cascade)
  stocks         Stock[]
  transfersFrom  Transfer[]      @relation("TransferFrom")
  transfersTo    Transfer[]      @relation("TransferTo")
  stockMovements StockMovement[]

  @@index([type])
  @@index([studioId])
  @@map("warehouses")
}

model Product {
  id          String      @id @default(uuid())
  name        String      // Наименование
  description String?     // Описание (необязательно)
  article     String?     // Артикул (необязательно)
  unit        ProductUnit // Единица: Кг/шт/мл
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  stocks         Stock[]
  transfers      Transfer[]
  stockMovements StockMovement[]

  @@map("products")
}

model Stock {
  warehouseId String
  productId   String
  quantity    Int      @default(0) // Кол-во (>= 0)
  updatedAt   DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([warehouseId, productId])
  @@index([warehouseId])
  @@index([productId])
  @@map("stocks")
}

model Transfer {
  id               String   @id @default(uuid())
  fromWarehouseId  String
  toWarehouseId    String
  productId        String
  quantity         Int
  createdAt        DateTime @default(now())
  createdByUserId  String

  fromWarehouse Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id], onDelete: Cascade)
  toWarehouse   Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy     User      @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([productId])
  @@index([createdAt])
  @@map("transfers")
}

model StockMovement {
  id               String            @id @default(uuid())
  warehouseId      String
  productId        String
  quantityDelta    Int               // + приход, - списание
  type             StockMovementType // RECEIPT | WRITE_OFF
  createdAt        DateTime          @default(now())
  createdByUserId  String

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([warehouseId])
  @@index([productId])
  @@index([createdAt])
  @@map("stock_movements")
}
