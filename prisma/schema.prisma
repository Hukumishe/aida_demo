// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  DEPUTY_OWNER
  SERVICE // Те же права что у владельца; доступ к панели промптов
  ADMIN
  MANAGER
  MASTER
  DEVELOPER // Платформа: создание организаций, полный доступ ко всем тенантам
}

enum AppointmentStatus {
  BOOKED
  CANCELLED
  ARRIVED
  DONE
}

enum ClientLevel {
  BRONZE // при регистрации, 3%
  SILVER // 50 000 ₸ оплачено, 5%
  GOLD // 120 000 ₸ оплачено, 10%
  DIAMOND // вручную, 30%
}

enum LogLevel {
  ERROR
  WARN
  INFO
  DEBUG
  VERBOSE
}

enum LogType {
  HTTP_REQUEST
  HTTP_RESPONSE
  ERROR
  AUTH
  DATABASE
  BUSINESS_LOGIC
  SYSTEM
}

enum NotificationType {
  NEW_APPOINTMENT // Новая запись для мастера
  APPOINTMENT_CANCELLED // Отмена записи для менеджера
  BLACKLIST_REQUEST // Запрос на добавление в черный список для владельца
  NEW_TASK // Назначена новая задача (исполнителю)
  TASK_DEADLINE_APPROACHING // Напоминание о приближающемся сроке задачи
  TASK_REJECTED // Мастер отказался от задачи (уведомление постановщику)
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

/// Тикеты в поддержку разработчиков (OWNER/DEPUTY создают; ведут DEVELOPER)
enum DevTicketStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

enum WarehouseType {
  CENTRAL
  BRANCH
}

enum ProductUnit {
  KG // Кг
  PCS // шт
  ML // мл
}

enum StockMovementType {
  RECEIPT // Приход
  WRITE_OFF // Списание
}

enum LandingPromotionType {
  DISCOUNT // Скидка на одну или несколько услуг
  ONE_PLUS_ONE // Акция 1+1 (две услуги по спеццене)
  SERVICE_BUNDLE // Набор из N услуг (1+1+1+…): одна общая цена, состав в landing_promotion_services
}

/// Лояльность: классический пресет (BRONZE/SILVER/GOLD/DIAMOND из кода) или свои уровни по студии
enum StudioLoyaltyMode {
  PRESET
  CUSTOM
}

// «Приведи друга»: награда приглашённому на первом визите
enum ReferFriendInviteeRewardType {
  DISCOUNT_PERCENT // скидка % на сумму визита (услуга + апсейлы)
  BONUS_PERCENT // бонусы % от суммы оплаты деньгами за визит
}

// «Приведи друга»: вознаграждение пригласившему после завершения записи приглашённого
enum ReferFriendReferrerRewardType {
  PERCENT_OF_PAYMENT // % от суммы оплаты деньгами приглашённого
  FIXED_AMOUNT // фиксированная сумма в мин. денежных единицах
}

// Аудитория услуги: MEN или WOMEN (одно значение на услугу)
enum ServiceAudience {
  MEN
  WOMEN
}

/// Тенант: сеть салонов в одной БД. Каталог услуг, CRM, маркетинг, склад, задачи и т.д. — на уровне организации.
model Organization {
  id                             String                         @id
  name                           String
  slug                           String?                        @unique
  globalBonusPaymentLimitPercent Int                            @default(30) // 0–100, лимит оплаты бонусами (только Owner)
  /// Маркетинг: акция «приведи друга»
  referFriendEnabled             Boolean                        @default(false)
  referFriendInviteeRewardType   ReferFriendInviteeRewardType?
  referFriendInviteeValue        Int?
  referFriendReferrerRewardType  ReferFriendReferrerRewardType?
  referFriendReferrerValue       Int?
  loyaltyMode                    StudioLoyaltyMode              @default(PRESET)
  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime                       @updatedAt

  studios               Studio[]
  users                 User[]
  clients               Client[]
  serviceCategories     ServiceCategory[]
  services              Service[]
  blacklistRequests     BlacklistRequest[]
  bonusHistory          BonusHistoryEntry[]
  landingPromotions     LandingPromotion[]
  landingMasters        LandingMaster[]
  landingServiceCards   LandingServiceCard[]
  loyaltyTiers          StudioLoyaltyTier[]
  loyaltyMilestones     StudioLoyaltyMilestone[]
  clientStudioLoyalties ClientStudioLoyalty[]
  studioTasks           StudioTask[]
  referralLinks         StudioReferralLink[]
  warehouses            Warehouse[]
  products              Product[]
  faqs                  OrganizationFaq[]
  prompts               Prompt[]
  notifications         Notification[]
  devTickets            DevTicket[]

  @@map("organizations")
}

/// Филиал: расписание, записи, склад филиала, уведомления с контекстом филиала.
model Studio {
  id             String   @id
  organizationId String
  name           String
  address        String?
  timezone       String   @default("Asia/Almaty")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users                 User[]
  workSchedules         WorkScheduleDay[]
  busySlots             BusySlot[]
  appointments          Appointment[]
  staffServices           StaffService[]
  staffServiceOverrides      StaffServiceOverride[]
  studioDisabledServices     StudioDisabledService[]
  studioDisabledCategories   StudioDisabledCategory[]
  noShowIncomes              NoShowIncome[]
  Notification            Notification[]
  warehouse               Warehouse?

  @@index([organizationId])
  @@map("studios")
}

/// Уровень лояльности (CUSTOM) на уровне организации
model StudioLoyaltyTier {
  id              String  @id
  organizationId  String
  sortOrder       Int
  name            String
  cashbackPercent Int
  manualOnly      Boolean @default(false)

  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAssignments ClientStudioLoyalty[] @relation("ClientStudioCurrentTier")

  @@unique([organizationId, sortOrder])
  @@index([organizationId])
  @@map("studio_loyalty_tiers")
}

/// Порог суммы оплат по организации → целевой sortOrder
model StudioLoyaltyMilestone {
  id              String @id
  organizationId  String
  minTotalPaid    Int
  targetSortOrder Int

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("studio_loyalty_milestones")
}

/// Учёт лояльности клиента в организации (CUSTOM): суммы по DONE по филиалам этой организации
model ClientStudioLoyalty {
  id               String  @id
  clientId         String
  organizationId   String
  currentTierId    String?
  totalPaid        Int     @default(0)
  levelSetManually Boolean @default(false)

  client       Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  currentTier  StudioLoyaltyTier? @relation("ClientStudioCurrentTier", fields: [currentTierId], references: [id], onDelete: SetNull)

  @@unique([clientId, organizationId])
  @@index([organizationId])
  @@map("client_studio_loyalties")
}

model Prompt {
  id             String   @id
  key            String
  description    String
  organizationId String? // null — общий промпт; иначе промпт организации (см. частичные unique-индексы в миграции)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, key])
  @@map("prompts")
}

/// FAQ / база знаний для дообучения агента (на уровне организации)
model OrganizationFaq {
  id             String   @id
  organizationId String
  question       String
  answer         String
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("organization_faqs")
}

model User {
  id              String   @id
  email           String?  @unique
  phone           String?  @unique
  passwordHash    String
  password        String? // Plain password (visible to OWNER and DEPUTY_OWNER)
  role            UserRole
  organizationId  String
  studioId        String? // филиал; null — только сетевые роли (пул организации)
  isActive        Boolean  @default(true)
  themePreference String? // 'light' | 'dark' | 'system'
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization              Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  studio                    Studio?                @relation(fields: [studioId], references: [id], onDelete: Cascade)
  staffProfile              StaffProfile?
  workSchedules             WorkScheduleDay[]
  busySlots                 BusySlot[]
  appointments              Appointment[]
  staffServices             StaffService[]
  serviceOverrides          StaffServiceOverride[]
  arrivedAppointments       Appointment[]          @relation("ArrivedByUser")
  noShowIncomes             NoShowIncome[]
  notifications             Notification[]
  blacklistRequests         BlacklistRequest[] // Запросы, созданные пользователем
  approvedBlacklistRequests BlacklistRequest[]     @relation("ApprovedByUser") // Запросы, одобренные пользователем
  bonusHistoryPerformed     BonusHistoryEntry[]    @relation("BonusPerformedBy") // Ручные корректировки бонусов
  transfers                 Transfer[]
  stockMovementsCreated     StockMovement[]        @relation("StockMovementCreatedBy")
  stockMovementsForStaff    StockMovement[]        @relation("StockMovementForStaff")

  landingMasters        LandingMaster[]
  tasksCreated          StudioTask[]           @relation("StudioTaskCreatedBy")
  tasksAssigned         StudioTask[]           @relation("StudioTaskAssignee")
  studioTaskControllers StudioTaskController[]

  devTicketsCreated     DevTicket[]            @relation("DevTicketCreator")
  devTicketMessages     DevTicketMessage[]
  devTicketsCompleted   DevTicket[]            @relation("DevTicketCompletedBy")

  @@index([organizationId])
  @@index([studioId])
  @@index([email])
  @@index([phone])
  @@map("users")
}

/// Тикет разработчикам (описание, шаги воспроизведения, скриншоты-URL)
model DevTicket {
  id                 String          @id
  organizationId   String
  createdByUserId    String
  title              String
  problemDescription String
  howItHappened      String?
  screenshotUrls     String[]        @default([])
  status             DevTicketStatus @default(OPEN)
  completedAt        DateTime?
  completedByUserId  String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User                @relation("DevTicketCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  completedBy  User?               @relation("DevTicketCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)
  messages     DevTicketMessage[]

  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
  @@map("dev_tickets")
}

model DevTicketMessage {
  id        String   @id
  ticketId  String
  userId    String
  body      String
  createdAt DateTime @default(now())

  ticket DevTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([createdAt])
  @@map("dev_ticket_messages")
}

model StaffProfile {
  userId           String   @id
  firstName        String
  lastName         String?
  title            String?
  category         String?
  providesServices Boolean  @default(true)
  avatar           String?
  bio              String?
  portfolioPhotos  String[]
  rank             String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff_profiles")
}

model Client {
  id                              String      @id
  organizationId                  String
  firstName                       String
  lastName                        String?
  phone                           String
  notes                           String?
  birthDate                       DateTime?   @db.Date // День рождения клиента
  level                           ClientLevel @default(BRONZE)
  levelSetManually                Boolean     @default(false) // true если DIAMOND назначен вручную (только режим PRESET)
  totalPaidForLevel               Int         @default(0) // Сумма оплаченных деньгами по DONE (для расчёта уровня в PRESET; глобально по клиенту)
  bonuses                         Int         @default(0) // Бонусные баллы (1 балл = 1 ₸)
  discount                        Int         @default(0) // Скидка в процентах (0-100)
  balance                         Int         @default(0) // Баланс в тенге (историческое поле)
  isBlacklisted                   Boolean     @default(false) // Флаг черного списка
  blacklistReason                 String? // Причина добавления в черный список
  referralCode                    String? // Уникальный код «приведи подругу» (общая база)
  /// Источник регистрации (название из маркетинговой реферальной ссылки)
  registrationSource              String?
  /// Регистрация по ссылке филиала (маркетинг)
  studioReferralLinkId            String?
  referredByClientId              String? // Кто привёл этого клиента (заполняется при первом визите с кодом)
  referralFirstVisitBonusCredited Boolean     @default(false) // 20% за первый визит уже начислены
  createdAt                       DateTime    @default(now())
  updatedAt                       DateTime    @updatedAt

  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  referredByClient   Client?               @relation("Referrer", fields: [referredByClientId], references: [id], onDelete: SetNull)
  referredClients    Client[]              @relation("Referrer")
  studioReferralLink StudioReferralLink?   @relation(fields: [studioReferralLinkId], references: [id], onDelete: SetNull)
  appointments       Appointment[]
  noShowIncomes      NoShowIncome[]
  blacklistRequests  BlacklistRequest[]
  bonusHistory       BonusHistoryEntry[]
  studioLoyalties    ClientStudioLoyalty[]

  @@unique([organizationId, phone])
  @@unique([organizationId, referralCode])
  @@index([isBlacklisted])
  @@index([studioReferralLinkId])
  @@index([organizationId])
  @@map("clients")
}

/// Маркетинговая реферальная ссылка (уровень организации)
model StudioReferralLink {
  id                       String    @id
  organizationId           String
  sourceName               String
  cashbackEnabled          Boolean   @default(false)
  cashbackPercent          Int?
  isActive                 Boolean   @default(true)
  lastActivityAt           DateTime?
  registrationsCount       Int       @default(0)
  totalCashbackAccumulated Int       @default(0)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clients      Client[]

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("studio_referral_links")
}

model WorkScheduleDay {
  id          String   @id
  studioId    String
  staffUserId String
  date        DateTime @db.Date
  startTime   String // HH:MM format
  endTime     String // HH:MM format
  breakStart  String? // HH:MM format
  breakEnd    String? // HH:MM format
  isDayOff    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  staff  User   @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@unique([studioId, staffUserId, date])
  @@index([studioId, staffUserId, date])
  @@map("work_schedule_days")
}

model BusySlot {
  id                        String   @id
  studioId                  String
  staffUserId               String
  startAt                   DateTime
  endAt                     DateTime
  comment                   String?
  forfeitedPrepaymentAmount Int?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  staff  User   @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([studioId, staffUserId, startAt])
  @@map("busy_slots")
}

model ServiceCategory {
  id             String   @id
  organizationId String
  name           String
  sortOrder      Int      @default(0)
  /// Доступность категории в каталоге сети; при выключении синхронно выставляется всем услугам категории.
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  services                 Service[]
  studioDisabledCategories StudioDisabledCategory[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("service_categories")
}

model Service {
  id                  String          @id
  organizationId      String
  name                String
  defaultDurationMin  Int
  defaultPrice        Int?
  requiredStaffCount  Int             @default(1)
  isActive            Boolean         @default(true)
  bonusAccrualEnabled Boolean         @default(true)
  categoryId          String
  audience            ServiceAudience @default(WOMEN)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category           ServiceCategory        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  staffServices      StaffService[]
  staffOverrides     StaffServiceOverride[]
  appointments       Appointment[]
  noShowIncomes      NoShowIncome[]
  appointmentUpsells AppointmentUpsell[]

  landingPromotionServices LandingPromotionService[]
  landingServiceCards      LandingServiceCard[]
  studioDisabledServices   StudioDisabledService[]

  @@index([organizationId])
  @@map("services")
}

/// Услуга отключена в конкретном филиале: общий каталог организации не меняется, другие филиалы не затрагиваются.
model StudioDisabledService {
  studioId  String
  serviceId String
  createdAt DateTime @default(now())

  studio  Studio  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([studioId, serviceId])
  @@index([serviceId])
  @@map("studio_disabled_services")
}

/// Категория отключена в филиале: все услуги категории недоступны здесь (каталог сети не меняется).
model StudioDisabledCategory {
  studioId   String
  categoryId String
  createdAt  DateTime @default(now())

  studio   Studio          @relation(fields: [studioId], references: [id], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([studioId, categoryId])
  @@index([categoryId])
  @@map("studio_disabled_categories")
}

// --- Настройки лендинга ---

model LandingPromotion {
  id              String               @id
  organizationId  String
  type            LandingPromotionType
  title           String
  description     String?
  isActive        Boolean              @default(true)
  discountPercent Int?
  serviceIdA      String?
  serviceIdB      String?
  bundlePrice     Int?
  validUntil      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  services     LandingPromotionService[]
  codes        LandingPromotionCode[]

  @@index([organizationId])
  @@map("landing_promotions")
}

model LandingPromotionService {
  id          String @id
  promotionId String
  serviceId   String

  promotion LandingPromotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  service   Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@index([serviceId])
  @@map("landing_promotion_services")
}

model LandingPromotionCode {
  id          String    @id
  promotionId String
  code        String    @unique
  usageLimit  Int? // Максимальное количество использований (null = без лимита)
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  promotion LandingPromotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@map("landing_promotion_codes")
}

model LandingMaster {
  id             String  @id
  organizationId String
  staffUserId    String
  isVisible      Boolean @default(true)
  order          Int     @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        User         @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@unique([organizationId, staffUserId])
  @@index([organizationId])
  @@index([staffUserId])
  @@map("landing_masters")
}

model LandingServiceCard {
  id             String   @id
  organizationId String
  serviceId      String
  title          String?
  description    String?
  imageUrl       String?
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([organizationId, serviceId])
  @@index([organizationId])
  @@index([serviceId])
  @@map("landing_service_cards")
}

model StaffService {
  id          String   @id
  studioId    String
  staffUserId String
  serviceId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studio  Studio  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  staff   User    @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([studioId, staffUserId, serviceId])
  @@index([studioId, staffUserId])
  @@index([serviceId])
  @@map("staff_services")
}

model StaffServiceOverride {
  id          String   @id
  studioId    String
  staffUserId String
  serviceId   String
  durationMin Int?
  price       Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studio  Studio  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  staff   User    @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([studioId, staffUserId, serviceId])
  @@index([studioId, staffUserId])
  @@map("staff_service_overrides")
}

model Appointment {
  id                        String            @id
  studioId                  String
  staffUserId               String
  clientId                  String
  serviceId                 String
  startAt                   DateTime
  endAt                     DateTime
  status                    AppointmentStatus @default(BOOKED)
  prepaymentAmount          Int?
  forfeitedPrepaymentAmount Int? // Предоплата, сгоревшая при поздней отмене
  completedBonusesUsed      Int? // Сколько бонусов списано при завершении (DONE)
  completedMoneyPaid        Int? // Сумма, оплаченная деньгами при DONE (для уровня и кэшбэка)
  arrivedAt                 DateTime?
  arrivedByUserId           String?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  studio        Studio              @relation(fields: [studioId], references: [id], onDelete: Cascade)
  staff         User                @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  client        Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service       Service             @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  arrivedByUser User?               @relation("ArrivedByUser", fields: [arrivedByUserId], references: [id])
  upsells       AppointmentUpsell[]

  @@index([studioId, staffUserId, startAt])
  @@index([studioId, startAt])
  @@index([clientId])
  @@map("appointments")
}

model AppointmentUpsell {
  id            String   @id
  appointmentId String
  serviceId     String
  quantity      Int      @default(1)
  price         Int
  totalAmount   Int
  comment       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([appointmentId])
  @@index([serviceId])
  @@index([appointmentId, createdAt])
  @@map("appointment_upsells")
}

model Log {
  id             String   @id
  level          LogLevel
  type           LogType
  message        String
  context        String?
  userId         String?
  organizationId String?
  studioId       String?
  ip             String?
  userAgent      String?
  method         String?
  url            String?
  statusCode     Int?
  error          String?
  duration       Int?
  createdAt      DateTime @default(now())

  @@index([level])
  @@index([type])
  @@index([createdAt])
  @@index([userId])
  @@index([organizationId])
  @@index([studioId])
  @@map("logs")
}

model NoShowIncome {
  id              String   @id
  studioId        String
  staffUserId     String
  clientId        String
  serviceId       String
  amount          Int // Сумма предоплаты, добавленная в доход
  originalStartAt DateTime // Оригинальное время начала записи
  originalEndAt   DateTime // Оригинальное время окончания записи
  createdAt       DateTime @default(now())

  studio  Studio  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  staff   User    @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([studioId, createdAt])
  @@index([studioId, originalStartAt])
  @@map("no_show_incomes")
}

model Notification {
  id             String           @id
  userId         String
  organizationId String
  studioId       String?
  type           NotificationType
  title          String
  message        String
  data           String?
  isRead         Boolean          @default(false)
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  studio       Studio?      @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([organizationId, createdAt])
  @@index([studioId, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// Задача на уровне организации: исполнитель, контролёры, дедлайн
model StudioTask {
  id                     String     @id
  organizationId         String
  title                  String
  description            String?
  rejectionComment       String?
  assigneeUserId         String
  createdByUserId        String
  deadlineAt             DateTime
  status                 TaskStatus @default(OPEN)
  deadlineReminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee     User                   @relation("StudioTaskAssignee", fields: [assigneeUserId], references: [id], onDelete: Cascade)
  createdBy    User                   @relation("StudioTaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  controllers  StudioTaskController[]

  @@index([organizationId])
  @@index([assigneeUserId])
  @@index([deadlineAt])
  @@index([organizationId, status])
  @@map("studio_tasks")
}

/// Постановщик/контролёр задачи (менеджеры филиала) — получают напоминание о дедлайне
model StudioTaskController {
  id     String @id
  taskId String
  userId String

  task StudioTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
  @@map("studio_task_controllers")
}

model BlacklistRequest {
  id                String    @id
  organizationId    String
  clientId          String
  requestedByUserId String
  approvedByUserId  String?
  status            String    @default("PENDING")
  reason            String?
  rejectedReason    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  approvedAt        DateTime?
  rejectedAt        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation(fields: [requestedByUserId], references: [id], onDelete: Cascade)
  approvedBy   User?        @relation("ApprovedByUser", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([clientId])
  @@index([status])
  @@index([requestedByUserId])
  @@index([organizationId, status])
  @@map("blacklist_requests")
}

model BonusHistoryEntry {
  id                String   @id
  clientId          String
  organizationId    String
  amount            Int
  type              String
  appointmentId     String?
  performedByUserId String?
  comment           String?
  createdAt         DateTime @default(now())

  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  performedBy  User?        @relation("BonusPerformedBy", fields: [performedByUserId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([organizationId])
  @@index([createdAt])
  @@map("bonus_history")
}

// --- Склад (номенклатура и движение — на уровне организации; филиальный склад привязан к студии) ---
model Warehouse {
  id             String        @id
  organizationId String
  type           WarehouseType
  studioId       String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  studio         Studio?         @relation(fields: [studioId], references: [id], onDelete: Cascade)
  stocks         Stock[]
  transfersFrom  Transfer[]      @relation("TransferFrom")
  transfersTo    Transfer[]      @relation("TransferTo")
  stockMovements StockMovement[]

  @@index([type])
  @@index([organizationId])
  @@index([studioId])
  @@map("warehouses")
}

model Product {
  id             String      @id
  organizationId String
  name           String
  description    String?
  article        String?
  unit           ProductUnit
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stocks         Stock[]
  transfers      Transfer[]
  stockMovements StockMovement[]

  @@index([organizationId])
  @@map("products")
}

model Stock {
  warehouseId String
  productId   String
  quantity    Int      @default(0) // Кол-во (>= 0)
  updatedAt   DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([warehouseId, productId])
  @@index([warehouseId])
  @@index([productId])
  @@map("stocks")
}

model Transfer {
  id              String   @id
  fromWarehouseId String
  toWarehouseId   String
  productId       String
  quantity        Int
  createdAt       DateTime @default(now())
  createdByUserId String

  fromWarehouse Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id], onDelete: Cascade)
  toWarehouse   Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy     User      @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([productId])
  @@index([createdAt])
  @@map("transfers")
}

model StockMovement {
  id              String            @id
  warehouseId     String
  productId       String
  quantityDelta   Int // + приход, - списание
  type            StockMovementType // RECEIPT | WRITE_OFF
  createdAt       DateTime          @default(now())
  createdByUserId String
  // Мастер филиала, в пользу которого списан товар (только для WRITE_OFF)
  forStaffUserId  String?

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy User      @relation("StockMovementCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  forStaff  User?     @relation("StockMovementForStaff", fields: [forStaffUserId], references: [id], onDelete: SetNull)

  @@index([warehouseId])
  @@index([productId])
  @@index([createdAt])
  @@index([forStaffUserId])
  @@map("stock_movements")
}
