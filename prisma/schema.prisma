// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  MANAGER
  MASTER
}

enum AppointmentStatus {
  BOOKED
  CANCELLED
  ARRIVED
  DONE
}

model Studio {
  id        String   @id @default(uuid())
  name      String
  address   String?
  timezone  String   @default("Asia/Almaty")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  clients            Client[]
  workSchedules      WorkScheduleDay[]
  busySlots          BusySlot[]
  services           Service[]
  appointments       Appointment[]
  staffServiceOverrides StaffServiceOverride[]

  @@map("studios")
}

model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  phone        String?  @unique
  passwordHash String
  role         UserRole
  studioId     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studio       Studio?        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  staffProfile StaffProfile?
  workSchedules WorkScheduleDay[]
  busySlots    BusySlot[]
  appointments Appointment[]
  serviceOverrides StaffServiceOverride[]
  arrivedAppointments Appointment[] @relation("ArrivedByUser")

  @@index([studioId])
  @@index([email])
  @@index([phone])
  @@map("users")
}

model StaffProfile {
  userId          String  @id
  firstName       String
  lastName        String?
  title           String?
  category        String?
  providesServices Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff_profiles")
}

model Client {
  id        String   @id @default(uuid())
  studioId  String
  firstName String
  lastName  String?
  phone     String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studio       Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([studioId, phone])
  @@index([studioId])
  @@map("clients")
}

model WorkScheduleDay {
  id         String   @id @default(uuid())
  studioId   String
  staffUserId String
  date       DateTime @db.Date
  startTime  String   // HH:MM format
  endTime    String   // HH:MM format
  breakStart String?  // HH:MM format
  breakEnd   String?  // HH:MM format
  isDayOff   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  studio     Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  staff      User   @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@unique([studioId, staffUserId, date])
  @@index([studioId, staffUserId, date])
  @@map("work_schedule_days")
}

model BusySlot {
  id                        String    @id @default(uuid())
  studioId                  String
  staffUserId               String
  startAt                   DateTime
  endAt                     DateTime
  comment                   String?
  forfeitedPrepaymentAmount Int?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  staff  User   @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([studioId, staffUserId, startAt])
  @@map("busy_slots")
}

model Service {
  id               String   @id @default(uuid())
  studioId         String
  name             String
  defaultDurationMin Int
  defaultPrice     Int?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  studio           Studio                @relation(fields: [studioId], references: [id], onDelete: Cascade)
  staffOverrides   StaffServiceOverride[]
  appointments     Appointment[]

  @@index([studioId])
  @@map("services")
}

model StaffServiceOverride {
  id          String   @id @default(uuid())
  studioId    String
  staffUserId String
  serviceId   String
  durationMin Int?
  price       Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studio  Studio  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  staff   User    @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([studioId, staffUserId, serviceId])
  @@index([studioId, staffUserId])
  @@map("staff_service_overrides")
}

model Appointment {
  id               String            @id @default(uuid())
  studioId         String
  staffUserId      String
  clientId         String
  serviceId        String
  startAt          DateTime
  endAt            DateTime
  status           AppointmentStatus @default(BOOKED)
  prepaymentAmount Int?
  arrivedAt        DateTime?
  arrivedByUserId  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  studio         Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  staff          User   @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  client         Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service        Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  arrivedByUser  User?   @relation("ArrivedByUser", fields: [arrivedByUserId], references: [id])

  @@index([studioId, staffUserId, startAt])
  @@index([studioId, startAt])
  @@index([clientId])
  @@map("appointments")
}

