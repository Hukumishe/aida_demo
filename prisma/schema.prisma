// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  MASTER
}

enum AppointmentStatus {
  BOOKED
  CANCELLED
  ARRIVED
  DONE
}

enum LogLevel {
  ERROR
  WARN
  INFO
  DEBUG
  VERBOSE
}

enum LogType {
  HTTP_REQUEST
  HTTP_RESPONSE
  ERROR
  AUTH
  DATABASE
  BUSINESS_LOGIC
  SYSTEM
}

enum NotificationType {
  NEW_APPOINTMENT // Новая запись для мастера
  APPOINTMENT_CANCELLED // Отмена записи для менеджера
}

model Studio {
  id        String   @id @default(uuid())
  name      String
  address   String?
  timezone  String   @default("Asia/Almaty")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  clients               Client[]
  workSchedules         WorkScheduleDay[]
  busySlots             BusySlot[]
  services              Service[]
  appointments          Appointment[]
  staffServices         StaffService[]
  staffServiceOverrides StaffServiceOverride[]
  noShowIncomes         NoShowIncome[]
  Notification          Notification[]

  @@map("studios")
}

model User {
  id              String   @id @default(uuid())
  email           String?  @unique
  phone           String?  @unique
  passwordHash    String
  role            UserRole
  studioId        String?
  isActive        Boolean  @default(true)
  themePreference String? // 'light' | 'dark' | 'system'
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  studio              Studio?                @relation(fields: [studioId], references: [id], onDelete: Cascade)
  staffProfile        StaffProfile?
  workSchedules       WorkScheduleDay[]
  busySlots           BusySlot[]
  appointments        Appointment[]
  staffServices       StaffService[]
  serviceOverrides    StaffServiceOverride[]
  arrivedAppointments Appointment[]          @relation("ArrivedByUser")
  noShowIncomes       NoShowIncome[]
  notifications       Notification[]

  @@index([studioId])
  @@index([email])
  @@index([phone])
  @@map("users")
}

model StaffProfile {
  userId           String   @id
  firstName        String
  lastName         String?
  title            String?
  category         String?
  providesServices Boolean  @default(true)
  avatar           String?
  bio              String?
  portfolioPhotos  String[]
  rank             String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff_profiles")
}

model Client {
  id        String   @id @default(uuid())
  studioId  String
  firstName String
  lastName  String?
  phone     String
  notes     String?
  bonuses   Int      @default(0) // Бонусные баллы
  discount  Int      @default(0) // Скидка в процентах (0-100)
  balance   Int      @default(0) // Баланс в тенге
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studio        Studio         @relation(fields: [studioId], references: [id], onDelete: Cascade)
  appointments  Appointment[]
  noShowIncomes NoShowIncome[]

  @@unique([studioId, phone])
  @@index([studioId])
  @@map("clients")
}

model WorkScheduleDay {
  id          String   @id @default(uuid())
  studioId    String
  staffUserId String
  date        DateTime @db.Date
  startTime   String // HH:MM format
  endTime     String // HH:MM format
  breakStart  String? // HH:MM format
  breakEnd    String? // HH:MM format
  isDayOff    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  staff  User   @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@unique([studioId, staffUserId, date])
  @@index([studioId, staffUserId, date])
  @@map("work_schedule_days")
}

model BusySlot {
  id                        String   @id @default(uuid())
  studioId                  String
  staffUserId               String
  startAt                   DateTime
  endAt                     DateTime
  comment                   String?
  forfeitedPrepaymentAmount Int?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  staff  User   @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([studioId, staffUserId, startAt])
  @@map("busy_slots")
}

model Service {
  id                 String   @id @default(uuid())
  studioId           String
  name               String
  defaultDurationMin Int
  defaultPrice       Int?
  requiredStaffCount Int      @default(1)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  studio             Studio                 @relation(fields: [studioId], references: [id], onDelete: Cascade)
  staffServices      StaffService[]
  staffOverrides     StaffServiceOverride[]
  appointments       Appointment[]
  noShowIncomes      NoShowIncome[]
  appointmentUpsells AppointmentUpsell[]

  @@index([studioId])
  @@map("services")
}

model StaffService {
  id          String   @id @default(uuid())
  studioId    String
  staffUserId String
  serviceId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studio  Studio  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  staff   User    @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([studioId, staffUserId, serviceId])
  @@index([studioId, staffUserId])
  @@index([serviceId])
  @@map("staff_services")
}

model StaffServiceOverride {
  id          String   @id @default(uuid())
  studioId    String
  staffUserId String
  serviceId   String
  durationMin Int?
  price       Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studio  Studio  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  staff   User    @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([studioId, staffUserId, serviceId])
  @@index([studioId, staffUserId])
  @@map("staff_service_overrides")
}

model Appointment {
  id                        String            @id @default(uuid())
  studioId                  String
  staffUserId               String
  clientId                  String
  serviceId                 String
  startAt                   DateTime
  endAt                     DateTime
  status                    AppointmentStatus @default(BOOKED)
  prepaymentAmount          Int?
  forfeitedPrepaymentAmount Int? // Предоплата, сгоревшая при поздней отмене
  arrivedAt                 DateTime?
  arrivedByUserId           String?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  studio        Studio              @relation(fields: [studioId], references: [id], onDelete: Cascade)
  staff         User                @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  client        Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service       Service             @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  arrivedByUser User?               @relation("ArrivedByUser", fields: [arrivedByUserId], references: [id])
  upsells       AppointmentUpsell[]

  @@index([studioId, staffUserId, startAt])
  @@index([studioId, startAt])
  @@index([clientId])
  @@map("appointments")
}

model AppointmentUpsell {
  id            String   @id @default(uuid())
  appointmentId String
  serviceId     String
  quantity      Int      @default(1)
  price         Int
  totalAmount   Int
  comment       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([appointmentId])
  @@index([serviceId])
  @@index([appointmentId, createdAt])
  @@map("appointment_upsells")
}

model Log {
  id         String   @id @default(uuid())
  level      LogLevel
  type       LogType
  message    String
  context    String? // JSON string with additional context
  userId     String? // User who triggered the action
  studioId   String? // Studio context
  ip         String? // IP address
  userAgent  String? // User agent
  method     String? // HTTP method
  url        String? // Request URL
  statusCode Int? // HTTP status code
  error      String? // Error stack trace or details
  duration   Int? // Request duration in ms
  createdAt  DateTime @default(now())

  @@index([level])
  @@index([type])
  @@index([createdAt])
  @@index([userId])
  @@index([studioId])
  @@map("logs")
}

model NoShowIncome {
  id              String   @id @default(uuid())
  studioId        String
  staffUserId     String
  clientId        String
  serviceId       String
  amount          Int // Сумма предоплаты, добавленная в доход
  originalStartAt DateTime // Оригинальное время начала записи
  originalEndAt   DateTime // Оригинальное время окончания записи
  createdAt       DateTime @default(now())

  studio  Studio  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  staff   User    @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([studioId, createdAt])
  @@index([studioId, originalStartAt])
  @@map("no_show_incomes")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String // Пользователь, которому адресовано уведомление
  studioId  String
  type      NotificationType
  title     String
  message   String
  data      String? // JSON с дополнительными данными (appointmentId, clientId и т.д.)
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([studioId, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}
